# Supabase
SUPABASE_URL=https://ykkjhmohqibepqovtjqs.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # Settings → API → service_role (NOT the anon/publishable key)

# OpenRouter — ONE gateway for every model call (AGENTS.md rule 3).
# Separate keys per cost centre, because OpenRouter reports usage and enforces a
# spend limit PER KEY. That is both the cost breakdown and the blast radius: a
# runaway in one feature must not drain the budget another one depends on.
#   pipeline    categorizer + ingest embeddings      (this file / CI)
#   concierge   chat + query embeddings              (Vercel)
#   flyer-scan  vision extraction from photos        (Vercel, see below)
#   discovery   scout                                (agent repo CI)
#   dev         local runs and benchmarks            (this file, locally)
OPENROUTER_API_KEY=your_openrouter_key_here

# Flyer scanner gets its OWN key, not a share of the concierge's. Vision calls
# cost multiples of a chat turn (the image is thousands of tokens), and the
# endpoint accepts 8 MB uploads from signed-in users — a different abuse profile
# entirely. Set in Vercel; unset locally means local scans bill to the dev key.
OPENROUTER_FLYER_SCAN_KEY=your_openrouter_flyer_scan_key_here

# Anthropic — legacy direct access, used by the generic_website and instagram
# scrapers. Both are being moved onto the gateway above (see docs/BACKLOG.md);
# until then they need this. Leave empty to skip them.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Eventbrite
EVENTBRITE_API_KEY=your_eventbrite_api_key_here

# Meetup (OAuth2 — see https://www.meetup.com/api/oauth/list/)
MEETUP_API_KEY=your_meetup_api_key_here

# kulturdaten.berlin (free, register at kulturdaten.berlin)
KULTURDATEN_API_KEY=your_kulturdaten_api_key_here

# Optional: proxy rotation for RA scraper (e.g. Bright Data, Oxylabs)
# PROXY_URL=http://user:pass@proxy.example.com:8080

# Pipeline settings
LOG_LEVEL=INFO
DRY_RUN=false   # set true to scrape without writing to DB
