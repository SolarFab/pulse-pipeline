# Supabase
SUPABASE_URL=https://ykkjhmohqibepqovtjqs.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # Settings → API → service_role (NOT the anon/publishable key)

# Anthropic (for categorization + extraction)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Eventbrite
EVENTBRITE_API_KEY=your_eventbrite_api_key_here

# Meetup (OAuth2 — see https://www.meetup.com/api/oauth/list/)
MEETUP_API_KEY=your_meetup_api_key_here

# kulturdaten.berlin (free, register at kulturdaten.berlin)
KULTURDATEN_API_KEY=your_kulturdaten_api_key_here

# Optional: proxy rotation for RA scraper (e.g. Bright Data, Oxylabs)
# PROXY_URL=http://user:pass@proxy.example.com:8080

# Pipeline settings
LOG_LEVEL=INFO
DRY_RUN=false   # set true to scrape without writing to DB
